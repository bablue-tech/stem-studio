# Cloud storage (Cloudinary — free tier: 25GB storage + 25GB bandwidth/month)
# Get values at https://console.cloudinary.com → Dashboard → "Product Environment Credentials"
# When all three are set, finished stems upload to the CDN and local copies are freed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=3010
